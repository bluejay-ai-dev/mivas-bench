# env / secrets
.env
.env.*
!.env.example

# python / uv
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
uv.toml

# local industry DB runtime state
**/db/runtime.db
**/db/runtime.db-*
# per-call SQLite copies (X-Mivas-Call-Id isolation)
**/db/calls/

# cached provider-side agent IDs (e.g. ElevenLabs ensure_agents)
**/.agents.json

# cartesia CLI-managed deploy state (agent id, deployment pointers)
**/line_agent/.cartesia/

# cached Bluejay agent/sim/DH ids (pipecat harness bootstrap)
**/.bluejay-ids.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.cursor/
*.swp
*~

# k8s / docker scratch
*.local.yaml

# internal handoff docs, not shipped. The bare pattern matches at any depth, so
# industry packs are exempted: industries/<slug>/docs/ is part of the pack contract
# (RESEARCH / SPEC / SPEC_TRACE / ONEPAGER) and tests/test_industry_contract.py
# allows it.
docs/
!industries/*/docs/
graphify-out/
