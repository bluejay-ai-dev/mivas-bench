# MIVAS run config
# Pick a harness from voice-agent-harnesses/ and an industry from industries/.
# Crossing the two builds a full runtime; Bluejay runs the evals and returns results.
# Exact Bluejay invocation is TBD.

# --- single run ---
# Harness is family/runtime under voice-agent-harnesses/ (Faraz layout).
HARNESS=openai/realtime-2.1
INDUSTRY=control-industry

# Tool server (harness → industry FastAPI proxy)
TOOL_SERVER_URL=http://127.0.0.1:8000
TOOL_SERVER_PORT=8000
# MIVAS_DB_PATH=industries/control-industry/db/runtime.db

# Required for live OpenAI sessions (also used by kubectl secret if missing)
OPENAI_API_KEY=

# Gemini Live (google-genai SDK)
GOOGLE_API_KEY=

# AssemblyAI Voice Agent (raw websocket)
ASSEMBLYAI_API_KEY=
# ASSEMBLYAI_VOICE=alba
# ASSEMBLYAI_GREETING=

# Deepgram Voice Agent (raw websocket)
DEEPGRAM_API_KEY=
# DEEPGRAM_LISTEN_MODEL=flux-general-en
# DEEPGRAM_THINK_MODEL=gpt-4.1
# DEEPGRAM_SPEAK_MODEL=aura-2-thalia-en
# DEEPGRAM_GREETING=

# ElevenLabs Conversational AI (native multi-agent via transfer_to_agent)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_GREETING=
# ensure_agents() creates + caches these in voice-agent-harnesses/elevenlabs/.agents.json;
# set both to skip creation and reuse existing agents instead.
# ELEVENLABS_RECEPTIONIST_AGENT_ID=
# ELEVENLABS_SCHEDULER_AGENT_ID=

# Vapi (squad multi-agent; deepgram flux + gpt-4.1 + eleven_flash_v2_5)
VAPI_API_KEY=
# VAPI_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Retell (retell-llm states multi-agent; gpt-4.1 + eleven_flash_v2_5, deepgram STT — no Flux available)
RETELL_API_KEY=
# RETELL_LIVEKIT_URL=wss://retell-ai-4ihahnq7.livekit.cloud

# Bland (in-house stack; conversational pathway multi-agent)
BLAND_API_KEY=

# Cartesia Line (code-first agent deployed via the cartesia CLI)
CARTESIA_API_KEY=
# CARTESIA_AGENT_ID=

# LiveKit SIP workers — same Cloud project Bluejay SIP-dials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# SIP host is the project's SIP id (`xxx.sip.livekit.cloud`), not the wss name.
# LIVEKIT_SIP_HOST=
# LIVEKIT_SIP_NUMBER=+15551230000
# Optional dedicated LiveKit Cloud project for SIP inbound (healthcare cascaded).
# LIVEKIT_SIP_URL=
# LIVEKIT_SIP_API_KEY=
# LIVEKIT_SIP_API_SECRET=
# NOTE: the LiveKit ElevenLabs plugin reads ELEVEN_API_KEY, not ELEVENLABS_API_KEY.
# ELEVEN_API_KEY=
# livekit-agents conflicts with the pinned livekit>=1.1.0 the retell harness needs, so the
# livekit harness ships its own requirements.txt + .venv rather than joining the shared deps.

# NVIDIA Nemotron (cascaded Pipecat pipeline — family/runtime = nvidia/nemotron)
NVIDIA_API_KEY=
# NEMOTRON_LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b
# NEMOTRON_TTS_VOICE=Magpie-Multilingual.EN-US.Aria
# Cloud NVCF is the default. For a local/LAN NIM (no TLS, no function_id):
# NEMOTRON_LLM_BASE_URL=http://<gpu-host>:18000/v1
# NEMOTRON_LLM_MODEL=nvidia/nemotron-3-nano
# NEMOTRON_ASR_SERVER=<gpu-host>:50152
# NEMOTRON_TTS_SERVER=<gpu-host>:50151
# NEMOTRON_USE_SSL=false
# NEMOTRON_ASR_FUNCTION_ID=
# pipecat-ai[nvidia] is installed from voice-agent-harnesses/nvidia/requirements.txt

# NVIDIA Nemotron VoiceChat (full-duplex S2S NIM — family/runtime = nvidia/nemotron-voicechat)
# Default: hosted NVCF wss://grpc.nvcf.nvidia.com/v1/realtime (needs NVIDIA_API_KEY)
# Dual-session multi-agent: one WS per blueprint agent; idle gets no audio.
# Local NIM: VOICECHAT_WS_URL=ws://127.0.0.1:9000/v1/realtime
# VOICECHAT_WS_URL=wss://grpc.nvcf.nvidia.com/v1/realtime
# VOICECHAT_FUNCTION_ID=42c86b5f-545a-4b2f-a83b-90fd71da9912
# VOICECHAT_SPEAKS_FIRST=true   # speech-shaped kick (not zero-PCM); see nvidia/README.md

# Grok / xAI Speech-to-Speech (family/runtime = grok/voice)
# Docs: https://docs.x.ai/developers/model-capabilities/audio/voice-agent
GROK_API_KEY=
# XAI_API_KEY=            # alias for GROK_API_KEY
# GROK_VOICE_MODEL=grok-voice-latest
# GROK_VOICE=eve
# GROK_WS_URL=wss://api.x.ai/v1/realtime
# CHIRP_PORT=8768         # do not share ports with other local CHIRP harnesses


# Twilio ConversationRelay over SIP (family/runtime = twilio/conversationrelay-gpt4.1)
# Guide: https://www.twilio.com/en-us/blog/developers/tutorials/product/ai-agent-conversationrelay-voice-mistral
# Deviation: Bluejay connection_type=SIP → Twilio Programmable Voice SIP Domain → CR TwiML
# (LLM is GPT-4.1 via OPENAI_API_KEY — not Mistral/Hugging Face)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# PUBLIC_URL=
# TWILIO_LLM_MODEL=gpt-4.1
# TWILIO_WELCOME_GREETING=Welcome to Bluejay's Repair Services!
# CHIRP_PORT=8773         # ConversationRelay local server (not PCM CHIRP)
# BLUEJAY_API_URL=https://api.getbluejay.ai/v1   # needed for OTel tool actuals (not the local tool server)

# Pipecat Daily SIP worker (not LiveKit). Daily pinless INVITE → cluster dispatcher
# → idle k8s replica. Bluejay connection_type=SIP with DAILY_SIP_URI from pinless_setup.py.
DAILY_API_KEY=
# DAILY_SIP_URI=
# pipecat-ai is installed from voice-agent-harnesses/pipecat/requirements.txt, not the shared deps.

# Public https URL of the chirp tunnel — provider-side tools are pushed to
# {PUBLIC_URL}/tool/<name> on every boot, since the tunnel URL is ephemeral.
# PUBLIC_URL=

# CHIRP WebSocket adapter (Bluejay → harness)
# CHIRP_USER=mivas
# CHIRP_PASS=mivas
# CHIRP_PORT=8765   # nvidia 8766 / grok 8768 / vapi 8770 / retell 8771 / bland 8772 / cartesia 8773
# INDUSTRY=control-industry

# Bluejay OTLP + link trace to sim result (Chirp sends X-Simulation-Result-Id on upgrade)
# BLUEJAY_API_KEY=                 # OTLP X-API-KEY + update-simulation-result
# BLUEJAY_OTLP_ENDPOINT=https://otlp.getbluejay.ai/v1/traces
# BLUEJAY_API_URL=https://api.getbluejay.ai/v1
# BLUEJAY_SERVICE_NAME=mivas-openai   # or mivas-gemini / mivas-assemblyai / mivas-deepgram /
#                                     # mivas-elevenlabs / mivas-vapi / mivas-retell / mivas-bland /
#                                     # mivas-cartesia / mivas-nvidia / mivas-grok

# --- Kubernetes / CHIRP ---
# MIVAS_MODE=chirp
# CHIRP_USER=mivas
# CHIRP_PASS=mivas
#
# EKS stable public URLs (Ingress + shared ALB). Host = {slug}.{MIVAS_BASE_DOMAIN}
MIVAS_BASE_DOMAIN=
MIVAS_ACM_CERTIFICATE_ARN=
MIVAS_IMAGE_PREFIX=
# MIVAS_REPLICAS=1   # default 1. CHIRP-native pairs may use 3.
#                    # max_concurrent ≈ replicas × in_process_ws_limit (start 2–4)
#                    # Do not set >1 on vapi/retell/bland/cartesia.
#                    # Re-apply a scaled pair with MIVAS_REPLICAS=3 or it scales back to 1.
# MIVAS_SNAPSHOT_BUCKET=   # S3 bucket for hangup {id}.final.json + {id}.db
# MIVAS_SNAPSHOT_PREFIX=mivas
# AWS_DEFAULT_REGION=

#
# Local / kind (no MIVAS_BASE_DOMAIN):
# MIVAS_SERVICE_TYPE=LoadBalancer
# uv run python run.py --build --apply

# --- agents (optional) ---
# Comma-separated family/runtime:industry pairs. When set, overrides HARNESS/INDUSTRY.
# Each entry gets its own CHIRP Deployment+Service on --build --apply.
# AGENTS=openai/realtime-2.1:healthcare,nvidia/nemotron:control-industry
