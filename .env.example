# MIVAS run config
# Pick a harness from voice-agent-harnesses/ and an industry from industries/.
# Crossing the two builds a full runtime; Bluejay runs the evals and returns results.
# Exact Bluejay invocation is TBD.

# --- single run ---
# Harness is family/runtime under voice-agent-harnesses/ (Faraz layout).
VOICE_AGENT=openai/realtime-2.1
INDUSTRY=control-industry

# Tool server (harness → industry FastAPI proxy)
TOOL_SERVER_URL=http://127.0.0.1:8000
TOOL_SERVER_PORT=8000
# MIVAS_DB_PATH=industries/control-industry/db/runtime.db

# Required for live OpenAI sessions (also used by kubectl secret if missing)
OPENAI_API_KEY=

# Gemini Live (google-genai SDK)
GOOGLE_API_KEY=

# AssemblyAI Voice Agent (raw websocket)
ASSEMBLYAI_API_KEY=
# ASSEMBLYAI_VOICE=alba
# ASSEMBLYAI_GREETING=

# Deepgram Voice Agent (raw websocket)
DEEPGRAM_API_KEY=
# DEEPGRAM_LISTEN_MODEL=nova-3
# DEEPGRAM_THINK_MODEL=gpt-4o-mini
# DEEPGRAM_SPEAK_MODEL=aura-2-thalia-en
# DEEPGRAM_GREETING=

# ElevenLabs Conversational AI (native multi-agent via transfer_to_agent)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_GREETING=
# ensure_agents() creates + caches these in voice-agent-harnesses/elevenlabs/.agents.json;
# set both to skip creation and reuse existing agents instead.
# ELEVENLABS_RECEPTIONIST_AGENT_ID=
# ELEVENLABS_SCHEDULER_AGENT_ID=

# CHIRP WebSocket adapter (Bluejay → harness)
# CHIRP_USER=mivas
# CHIRP_PASS=mivas
# CHIRP_PORT=8765
# INDUSTRY=control-industry

# Bluejay OTLP + link trace to sim result (Chirp sends X-Simulation-Result-Id on upgrade)
# BLUEJAY_API_KEY=                 # OTLP X-API-KEY + update-simulation-result
# BLUEJAY_OTLP_ENDPOINT=https://otlp.getbluejay.ai/v1/traces
# BLUEJAY_API_URL=https://api.getbluejay.ai/v1
# BLUEJAY_SERVICE_NAME=mivas-openai   # or mivas-gemini / mivas-assemblyai / mivas-deepgram / mivas-elevenlabs

# --- Kubernetes / CHIRP ---
# MIVAS_MODE=chirp
# MIVAS_SERVICE_TYPE=LoadBalancer
# CHIRP_USER=mivas
# CHIRP_PASS=mivas
# kubectl create secret generic mivas-secrets \
#   --from-literal=OPENAI_API_KEY="$OPENAI_API_KEY" \
#   --from-literal=BLUEJAY_API_KEY="$BLUEJAY_API_KEY" \
#   --from-literal=CHIRP_USER=mivas --from-literal=CHIRP_PASS=mivas
# uv run python run.py --build --apply

# --- multiple runs (optional) ---
# Comma-separated voice_agent:industry pairs. When set, overrides the single-run vars above.
# RUNS=vapi:control-industry,openai:control-industry,livekit:healthcare
