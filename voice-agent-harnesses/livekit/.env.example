# LiveKit Cloud project the worker registers with (same project as the SIP host).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SIP inbound — host is the project's SIP id, not the wss project name.
# Bluejay agent sip_uri = sip:${LIVEKIT_SIP_NUMBER}@${LIVEKIT_SIP_HOST}
LIVEKIT_SIP_HOST=
LIVEKIT_SIP_NUMBER=+15551230000

# Optional dedicated project for SIP inbound (k8s secret mivas-livekit-sip).
# LIVEKIT_SIP_URL=wss://....livekit.cloud
# LIVEKIT_SIP_API_KEY=
# LIVEKIT_SIP_API_SECRET=

# Bluejay trace linking
BLUEJAY_API_URL=https://api.getbluejay.ai/v1
BLUEJAY_OTLP_ENDPOINT=https://otlp.getbluejay.ai/v1/traces
BLUEJAY_API_KEY=
BLUEJAY_SERVICE_NAME=mivas-livekit

INDUSTRY=control-industry
TOOL_SERVER_URL=http://127.0.0.1:8000

OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
# the livekit elevenlabs plugin reads ELEVEN_API_KEY, not ELEVENLABS_API_KEY
ELEVEN_API_KEY=
