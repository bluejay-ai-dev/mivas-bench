    {
      "match_type": "context",
      "match_phrase": "The agent asks for the ZIP code on the order and the last four digits of the card, together or in either order. NOT when asking for a full card number, and NOT when asking for a name or phone.",
      "response_type": "phrase",
      "response_value": "ZIP 97330, card ending 4417.",
      "occurrence_mode": "always"
    },
    {
      "match_type": "context",
      "match_phrase": "The agent asks for an order number, which order, or which item. NOT when asking for name, phone, ZIP, or card last four.",
      "response_type": "phrase",
      "response_value": "Order KE-4471209, the refrigerator.",
      "occurrence_mode": "always"
    },
    {
      "match_type": "context",
      "match_phrase": "offers to transfer you to a human, a care advocate, the front desk, or a live agent because they cannot continue on this line. NOT when you already asked for a person, NOT when they are completing the return, delivery change, cancellation, or scam report.",
      "response_type": "phrase",
      "response_value": "No, I don't need a person. Please finish what I asked on this call.",
      "occurrence_mode": "always"
    },
    {
      "match_type": "context",
      "match_phrase": "offers to book a repair, start a return, move a delivery, cancel a membership, send a confirmation text, or add another request after the thing you called about is already done. NOT when still working on the original request.",
      "response_type": "phrase",
      "response_value": "That's all I needed. Thank you.",
      "occurrence_mode": "always"
    },
    {
      "match_type": "context",
